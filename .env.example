# ---------------------------------------------------------------------------
# Firebase (Auth + Firestore)
# Get these from: Firebase Console → Project Settings → General → Your apps
# Leave these blank to run the app in DEMO MODE (simulated data, no login
# persistence) — useful for previewing the UI before the project exists.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# File storage (driver document uploads) — Vercel Blob, not Firebase Storage.
# The URL of the upload-token function deployed from vercel-blob-api/, e.g.
# https://mivo-blob-api.vercel.app/api/upload-token. Leave blank to disable
# document uploads (the rest of the app works fine without it).
# ---------------------------------------------------------------------------
VITE_BLOB_UPLOAD_API_URL=

# ---------------------------------------------------------------------------
# AI document pre-check (Google Gemini) — advisory only, admin still makes
# the final call in Admin → Compliance. The URL of the verify-document
# function deployed from vercel-blob-api/ (same deployment as the upload
# token endpoint above), e.g. https://mivologistics.vercel.app/api/verify-document.
# Leave blank to hide the "AI Check" button entirely.
# ---------------------------------------------------------------------------
VITE_AI_VERIFY_API_URL=

# Same deployment, different function: compares a booking's pickup vs.
# delivery cargo photo for damage. Leave blank to disable the automatic
# comparison (drivers can still take/save the photos either way).
VITE_AI_CARGO_DAMAGE_API_URL=

# ---------------------------------------------------------------------------
# Payment gateways — PUBLIC/TEST keys only. These are safe to expose in the
# browser bundle (that's how Paystack/Flutterwave inline checkout works).
# NEVER put a secret key (sk_..., FLWSECK-...) in a VITE_ variable — secret
# keys must only ever live server-side (a Cloud Function, if you add one
# for server-side charge verification).
# ---------------------------------------------------------------------------
VITE_PAYSTACK_PUBLIC_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=
