# ---------------------------------------------------------------------------
# Firebase (Auth + Firestore + Storage)
# Get these from: Firebase Console → Project Settings → General → Your apps
# Leave these blank to run the app in DEMO MODE (simulated data, no login
# persistence) — useful for previewing the UI before the project exists.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Payment gateways — PUBLIC/TEST keys only. These are safe to expose in the
# browser bundle (that's how Paystack/Flutterwave inline checkout works).
# NEVER put a secret key (sk_..., FLWSECK-...) in a VITE_ variable — secret
# keys must only ever live server-side (a Cloud Function, if you add one
# for server-side charge verification).
# ---------------------------------------------------------------------------
VITE_PAYSTACK_PUBLIC_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=
